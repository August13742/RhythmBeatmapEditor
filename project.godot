;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RhythmBeatmapEditor"
run/main_scene="uid://kutn31k4ypy4"
config/features=PackedStringArray("4.6", "C#", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://dvt2twtcrgvm2"

[autoload]

AudioManager="*uid://csln8r38jt1o"
CrossfadeManager="*res://Utility/CrossfadeManager.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"

[dotnet]

project/assembly_name="RhythmBeatmapEditor"

[editor]

naming/scene_name_casing=1

